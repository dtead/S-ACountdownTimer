 <body data-template-id="__page-root" class="w-full flex flex-col items-center justify-center gap-8 px-4" style="min-height: calc(100 * min(var(--vh,1vh),1vh)); background: radial-gradient(rgb(37, 26, 104), rgb(37, 29, 109), rgb(23, 19, 49));">
  <div class="flex flex-col items-center text-center">
   <h1 data-template-id="heading-text" class="canva-text mb-2" style="color: rgb(240, 240, 255); font-weight: 700; font-style: normal; font-size: 48px;">It's Almost Time!</h1>
   <p data-template-id="sub-text" class="canva-text" style="color: rgb(182, 195, 255); font-weight: 400; font-style: normal; font-size: 18px;">Thursday, August 27 · 7:00 PM</p>
  </div>
  <div class="relative flex items-center justify-center">
   <div class="glow"></div>
   <div class="pulse-ring"></div>
   <div class="pulse-ring"></div>
   <div class="spinner-ring"></div>
  </div>
  <div id="countdown" class="flex gap-6 sm:gap-10">
   <div class="countdown-unit">
    <span id="cd-days" class="countdown-value">--</span><span class="countdown-label">Days</span>
   </div>
   <div class="countdown-unit">
    <span id="cd-hours" class="countdown-value">--</span><span class="countdown-label">Hours</span>
   </div>
   <div class="countdown-unit">
    <span id="cd-mins" class="countdown-value">--</span><span class="countdown-label">Min</span>
   </div>
   <div class="countdown-unit">
    <span id="cd-secs" class="countdown-value">--</span><span class="countdown-label">Sec</span>
   </div>
  </div>
  <p data-template-id="status-text" class="canva-text" style="color: rgb(165, 180, 252); font-weight: 600; font-style: normal; font-size: 14px;">SEE YOU THERE 🍻</p>
  <script>
    const target = new Date('2026-08-27T19:00:00');
    function tick() {
      const diff = Math.max(0, target - Date.now());
      const s = Math.floor(diff/1000);
      document.getElementById('cd-days').textContent = String(Math.floor(s/86400)).padStart(2,'0');
      document.getElementById('cd-hours').textContent = String(Math.floor((s%86400)/3600)).padStart(2,'0');
      document.getElementById('cd-mins').textContent = String(Math.floor((s%3600)/60)).padStart(2,'0');
      document.getElementById('cd-secs').textContent = String(s%60).padStart(2,'0');
    }
    tick();
    setInterval(tick, 1000);

    const colors = ['#c084fc','#818cf8','#a5b4fc','#ddd6fe'];
    let lastR = 0;
    document.addEventListener('mousemove', e => {
      const now = Date.now();
      if (now - lastR < 80) return;
      lastR = now;
      const c = document.createElement('div');
      c.className = 'cursor-ripple';
      c.style.left = e.clientX + 'px';
      c.style.top = e.clientY + 'px';
      const r = document.createElement('div');
      r.className = 'ripple-ring';
      r.style.borderColor = colors[Math.floor(Math.random()*colors.length)];
      c.appendChild(r);
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 1500);
    });
  </script>
